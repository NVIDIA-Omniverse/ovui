#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "IntVecCube" (
        kind = "component"
    )
    {
        double size = 2.0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # Step 3.2: custom int vector attributes to exercise Vec2/3/4IntAttributeRow.
        custom int2 tileSize = (128, 256)
        custom int3 gridResolution = (8, 16, 32)
        custom int4 viewportBox = (0, 0, 1920, 1080)
    }
}
