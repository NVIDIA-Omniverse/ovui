()

over "World"
{
    def Cylinder "DeepCylinder"
    {
        double height = 1.0
        double radius = 0.3
        double3 xformOp:translate = (-2.0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
