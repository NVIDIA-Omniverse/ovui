(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.8
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 12
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.35, 0.37, 0.40)]
        double3 xformOp:translate = (0, -0.25, 0)
        float3 xformOp:scale = (1, 0.04, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "DynamicCube01" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = 1
        float physics:mass = 1
        vector3f physics:velocity = (0, 0, 0)
        vector3f physics:angularVelocity = (0, 0, 0)
        double3 xformOp:translate = (0, 5.5, 0)
        quatd xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "CubeGeom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.4
            bool physics:collisionEnabled = 1
            color3f[] primvars:displayColor = [(1.0, 0.18, 0.08)]
            float3[] extent = [(-0.7, -0.7, -0.7), (0.7, 0.7, 0.7)]
        }
    }

    def Xform "DynamicCube02" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = 1
        float physics:mass = 1
        vector3f physics:velocity = (0, 0, 0)
        vector3f physics:angularVelocity = (0, 0, 0)
        double3 xformOp:translate = (0, 7.5, 1)
        quatd xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "CubeGeom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.4
            bool physics:collisionEnabled = 1
            color3f[] primvars:displayColor = [(1.0, 0.18, 0.08)]
            float3[] extent = [(-0.7, -0.7, -0.7), (0.7, 0.7, 0.7)]
        }
    }
}
