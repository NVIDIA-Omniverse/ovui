# Build artifacts
build/
dist/
*.egg-info/
*.whl

# Generated build provenance — written by ovui/setup.py
ovui/python/omni/ui/_build_info.py

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Node.js (optional provider plugin runtimes -- do not commit)
node_modules/
npm-debug.log
yarn-error.log

# Compiled shared libraries
*.so
*.so.*
*.dylib
*.dll

# IDE
.vscode/
.idea/
*.swp
*~

# ImGui state
imgui.ini

# Test output
tests/golden/generated/
tests/output/
.coverage*
!.coveragerc
coverage.xml
coverage-reports/
htmlcov/

# Local crash/session artifacts.  Patterns are root-rooted so they don't
# swallow the tracked `core/` source tree or files named `core.py` / etc.
.codex
/core.[0-9]*
!/core/
!/core/**

# Local generated screenshots and debug repros
debug_inline.png
demo_screenshot.png
focused_test.png
image_showcase_final.png
examples/image_debug.py
examples/image_focused_test.py

# Local downloaded source/font caches
resources/fonts/JetBrainsMono-*.ttf
third_party/twemoji/

# Virtual environments
_venv/

# Eggs
*.egg
reference/

# Claude Code local worktrees
.claude/

# Markdown quality eval renders (regenerated by pipeline)
tests/markdown_quality/renders/
/ovui/markdown/quality_harness/tracker/results.json

# Historical manual proof scripts are not part of the pytest suite
/ovui-widgets/tests/qa_*.py
/ovui-widgets/tests/verify_*.py

# Oracle dev server local install
tests/markdown_quality/oracle/node_modules/
tests/markdown_quality/oracle/.vite/

# ──────────────────────────────────────────────────────────────────────
# Folded in from ovgear's .gitignore on monorepo merge
# ──────────────────────────────────────────────────────────────────────

# Python bytecode (broader pattern; covers .pyc/.pyo/.pyd)
*.py[cod]

# Pytest cache
.pytest_cache/

# Per-version venvs (e.g. _venv312/), supersets the bare _venv/ above
_venv*/

# Track per-component distribution stubs in the merged repo:
#   - ovui-widgets/dist/<sub>/pyproject.toml       (split widget dists)
#   - ovui-data-adapters/dist/<sub>/pyproject.toml (split adapter dists)
# The bare `dist/` rule above ignores any dist/ directory; these
# negations re-include only the tracked stub layouts. Do NOT
# un-ignore ovui/dist/ — that's the wheel-output directory of
# ovui/setup.py.
!ovui-widgets/dist/
!ovui-widgets/dist/*/
!ovui-widgets/dist/*/pyproject.toml
!ovui-data-adapters/dist/
!ovui-data-adapters/dist/*/
!ovui-data-adapters/dist/*/pyproject.toml
